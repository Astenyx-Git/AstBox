{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASTBOX",
  "version": "3.1.0",
  "identifier": "com.astenyx.astbox",
  "build": {
    "frontendDist": "../../../dist-web"
  },
  "app": {
    "windows": [
      {
        "title": "ASTBOX 容器管理器",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "licenseFile": "../../../installer/EULA.rtf",
    "resources": {
      "../../../installer/assets/astbox.ico": "astbox.ico",
      "../../../installer/assets/passbox.ico": "passbox.ico",
      "../../../installer/assets/app.ico": "app.ico",
      "../../../LICENSE": "LICENSE",
      "../../../LICENSE-MPL-2.0": "LICENSE-MPL-2.0",
      "../../../LICENSE-AGPL-3.0": "LICENSE-AGPL-3.0",
      "../../../NOTICE": "NOTICE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "../../../installer/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["../../../installer/assoc-cleanup.wxs"],
        "componentGroupRefs": ["AstboxAssocCleanup"]
      }
    }
  },
  "plugins": {}
}
