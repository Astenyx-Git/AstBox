<Project>

  <!-- Restricted-session workaround: Microsoft.NET.ILLink.tasks registers
       its tasks with TaskFactory="TaskHostFactory", which requires an
       out-of-proc MSBuild task host connected over a named pipe. Sandboxed
       sessions cannot open named pipes, so publishing fails with
       MSB4216/MSB4027. Re-registering the tasks without an explicit
       factory runs them in-proc instead. No effect outside publish. -->
  <UsingTask TaskName="ComputeManagedAssemblies"
             AssemblyFile="$(ILLinkTasksAssembly)"
             Condition="'$(ILLinkTasksAssembly)' != ''" />
  <UsingTask TaskName="ILLink"
             AssemblyFile="$(ILLinkTasksAssembly)"
             Condition="'$(ILLinkTasksAssembly)' != ''" />

</Project>
