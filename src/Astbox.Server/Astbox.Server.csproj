<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Astbox.Server</RootNamespace>
    <AssemblyName>astbox-server</AssemblyName>
    <!-- 窗口子系统:双击/文件关联启动时不出现命令行黑框(CLI 保持 Exe 不受影响) -->
    <OutputType>WinExe</OutputType>
    <PublishAot>true</PublishAot>
    <!-- 应用本体图标(exe 嵌入 / 任务栏):与文件关联图标(astbox.ico)分离 -->
    <ApplicationIcon>..\..\installer\assets\app.ico</ApplicationIcon>
    <!-- NFC 归一化(CBOR 规范文本)依赖 ICU,禁止不变全球化 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI (CurrentUser) secrets store -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Astbox.Core\Astbox.Core.csproj" />
  </ItemGroup>

  <!-- gui 前端零改动复用:从仓库根 gui/ 复制为静态资源 -->
  <ItemGroup>
    <Content Include="..\..\gui\**\*" CopyToOutputDirectory="PreserveNewest" Link="gui\%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
