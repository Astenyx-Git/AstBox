<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Astbox</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- libsodium 绑定:XChaCha20-Poly1305 与 16B 盐 Argon2id 快速路径(NativeAOT 兼容) -->
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <!-- 纯托管 Argon2id:支持任意盐长/并行度(ASTBOX 槽位盐为 32B,libsodium 不接受) -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- 纯 C# 二维码(矩阵 + PNG,无 System.Drawing) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
