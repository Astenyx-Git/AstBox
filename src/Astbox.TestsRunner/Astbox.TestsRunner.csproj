<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Astbox.TestsRunner</RootNamespace>
    <AssemblyName>astbox-tests</AssemblyName>
    <PublishAot>true</PublishAot>
    <!-- NFC normalization (CBOR canonical text) requires ICU; do NOT use
         InvariantGlobalization here or in any ASTBOX-facing app. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Astbox.Core\Astbox.Core.csproj" />
  </ItemGroup>

</Project>
